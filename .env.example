# ─── Banco de dados ────────────────────────────────────────────────────────────
# Sem DATABASE_URL a aplicação roda com o repositório em memória (catálogo seed).
# Com a URL preenchida, os repositórios Prisma assumem automaticamente.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gengar_games?schema=public"

# ─── Auth.js / NextAuth ────────────────────────────────────────────────────────
AUTH_SECRET="troque-por-uma-string-aleatoria-de-32-caracteres"
AUTH_TRUST_HOST=true
NEXTAUTH_URL="http://localhost:3000"

# ─── Stripe ────────────────────────────────────────────────────────────────────
# Ausentes: o checkout roda em modo simulação (pedido criado, pagamento mockado).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ─── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
